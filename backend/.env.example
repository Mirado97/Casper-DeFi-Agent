# Anthropic API ключ для агента
ANTHROPIC_API_KEY=sk-ant-...

# Базовый URL API (прокси). Хост БЕЗ /v1 — SDK сам допишет /v1/messages.
# Если прокси будет ругаться на путь — попробуй вариант с /v1 на конце.
ANTHROPIC_BASE_URL=https://api.vibecode-claude.online

# Модель агента. Для разработки дешевле sonnet, для финального демо можно opus.
# Варианты: claude-sonnet-4-6 | claude-opus-4-8 | claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-4-6

# Публичный CSPR.trade MCP сервер (свопы, цены, ликвидность, портфель)
CSPR_TRADE_MCP_URL=https://mcp.cspr.trade/mcp

# Порт бэкенда (8787 занят локальным прокси — используем 8799)
PORT=8799

# --- Кошелёк агента для локальной подписи (non-custodial) ---
# Без ключа агент стартует с эфемерным ключом (подпись работает, но средств нет).
# Укажи ОДИН из вариантов для реальных сделок:
# CASPER_SECRET_KEY_PEM=C:\path\to\secret_key.pem
# CASPER_SECRET_KEY_HEX=<64 hex символа приватного ключа>
# Алгоритм ключа: ed25519 (по умолчанию) или secp256k1
CASPER_KEY_ALGO=ed25519

# --- x402 микроплатежи агента ---
# local  = реальная EIP-712/secp256k1 подпись + крипто-верификация, без on-chain расчёта (демо)
# remote = проверка/расчёт через настоящий фасилитатор CSPR.cloud (нужен токен + CEP-18 баланс)
X402_FACILITATOR_MODE=local
X402_FACILITATOR_URL=https://x402-facilitator.cspr.cloud
# Токен доступа CSPR.cloud (для remote; в buildathon — спонсируемый доступ)
# X402_FACILITATOR_TOKEN=
X402_NETWORK=casper:casper
# secp256k1 ключ платёжного кошелька агента (64 hex). Пусто = эфемерный (ок для local).
# X402_PAYMENT_KEY_HEX=
# Цена премиум-вызова и подпись для UI
X402_PRICE=1000000
X402_PRICE_LABEL=0.001 USDC
